            color: #d97706;
            text-align: center;
            margin-top: 40px;
            font-weight: bold;
            text-shadow: 0 0 10px rgba(217, 119, 6, 0.5);
        }

        .constitution-card {
            background-color: rgba(2, 1, 1, 0.9);
            border: 1px solid #d97706;
            border-radius: 15px;
            padding: 30px;
            margin-top: 30px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.6);
        }

        .constitution-card h3 {
            color: #d97706;
            border-bottom: 2px solid #d97706;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .constitution-card p, .constitution-card li {
            color: #ffffff !important;
            font-size: 18px;
            line-height: 1.8;
        }
