<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المتجر | 𝐁𝐚𝐝𝐢𝐲𝐚𝐡 𝐑𝐏</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        body {
            margin: 0; padding: 0; font-family: sans-serif; color: white;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), #2d1e0f), 
                        url('https://i.postimg.cc/63L9DW1F/e998b817-4af0-45d3-b8ae-5e0c7e72fc6f.jpg');
            background-size: cover; background-position: center; background-repeat: no-repeat;
            background-attachment: fixed; min-height: 100vh;
        }

        .store-container {
            background-color: rgba(45, 30, 15, 0.8) !important;
            border: 1px solid #d97706 !important;
            padding: 40px;
            border-radius: 15px;
            margin-top: 30px;
            margin-bottom: 50px;
        }

        h1 { color: #d97706; text-align: center; margin-bottom: 30px; }
        
        .product-card {
            background-color: rgba(0, 0, 0, 0.5);
            border: 1px solid #d97706;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        
        .btn-custom {
            background-color: #d97706;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
            display: inline-block;
            margin-top: 15px;
            width: 100%;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-custom:hover {
            background-color: #b45309;
            color: white;
        }

        /* تنسيق عربة التسوق الجانبية */
        .cart-sidebar {
            position: fixed;
            top: 0;
            left: -350px;
            width: 350px;
            height: 100%;
            background-color: #1a1107;
            border-left: 2px solid #d97706;
            z-index: 1050;
            transition: left 0.3s ease;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: -5px 0 25px rgba(0,0,0,0.8);
        }

        .cart-sidebar.open {
            left: 0;
        }

        .cart-item-box {
            background: rgba(0, 0, 0, 0.6);
            border: 1px solid #d97706;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

<!-- شريط علوي خاص بالمتجر وعربة التسوق -->
<nav class="navbar navbar-dark bg-black bg-opacity-50 border-bottom border-warning px-4">
    <div class="container-fluid">
        <a href="/" class="btn btn-outline-warning btn-sm">الرئيسية</a>
        <button onclick="toggleCart()" class="btn btn-warning position-relative fw-bold text-dark">
            🛒 عربة التسوق 
            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
        </button>
    </div>
</nav>

<div class="container">
    <div class="store-container">
        <h1>متجر 𝐁𝐚𝐝𝐢𝐲𝐚𝐡 𝐑𝐏</h1>
        
        <div class="row g-4 justify-content-center">
            <% if (typeof products !== 'undefined' && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="col-md-4">
                        <div class="product-card">
                            <div>
                                <h3><%= product.name %></h3>
                                <p class="text-muted text-white-50"><%= product.description %></p>
                            </div>
                            <div>
                                <h4 class="text-warning mb-3"><%= product.price %> ر.س</h4>
                                <button onclick="addToCart('<%= product.id %>', '<%= product.name %>', '<%= product.price %>')" class="btn-custom">إضافة للسلة 🛍️</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center">
                    <p class="lead">لا توجد منتجات مضافة حالياً في المتجر.</p>
                </div>
            <% } %>
        </div>

        <div class="text-center mt-5">
            <a href="/" class="btn btn-outline-warning">العودة للرئيسية</a>
        </div>
    </div>
</div>

<!-- قائمة عربة التسوق الجانبية -->
<div id="cart-sidebar" class="cart-sidebar">
    <div>
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-warning pb-2">
            <h4 class="text-warning m-0">عربة التسوق</h4>
            <button onclick="toggleCart()" class="btn btn-sm btn-outline-danger">✕</button>
        </div>
        <div id="cart-items-container" style="max-height: 60vh; overflow-y: auto;">
            <!-- المنتجات تضاف هنا ديناميكياً -->
        </div>
    </div>
    <div class="border-top border-warning pt-3">
        <div class="d-flex justify-content-between mb-3 fw-bold">
            <span>الإجمالي:</span>
            <span id="cart-total" class="text-warning">0 ر.س</span>
        </div>
        <button onclick="proceedToCheckout()" class="btn btn-success w-full fw-bold py-2 w-100">إتمام الطلب 🚀</button>
    </div>
</div>

<footer style="text-align: center; margin-top: 50px; color: #fff; padding-bottom: 20px;">
    <p>جميع الحقوق محفوظة © 2026 البـــادية رول بــــلاي</p>
</footer>

<script>
    let cart = JSON.parse(localStorage.getItem('cart')) || [];

    function toggleCart() {
        document.getElementById('cart-sidebar').classList.toggle('open');
        updateCartUI();
    }

    function addToCart(id, name, price) {
        // تنظيف السعر في حال احتوى على نص مثل "ر.س" واستخراج الرقم فقط
        let cleanPrice = parseFloat(price.replace(/[^\d.]/g, '')) || 0;
        
        let existingItem = cart.find(item => item.id === id);
        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            cart.push({ id, name, price: cleanPrice, quantity: 1 });
        }
        
        saveCart();
        updateCartUI();
        alert('تمت إضافة المنتج إلى السلة بنجاح!');
    }

    function removeFromCart(id) {
        cart = cart.filter(item => item.id !== id);
        saveCart();
        updateCartUI();
    }

    function saveCart() {
        localStorage.setItem('cart', JSON.stringify(cart));
    }

    function updateCartUI() {
        let container = document.getElementById('cart-items-container');
        let countBadge = document.getElementById('cart-count');
        let totalSpan = document.getElementById('cart-total');

        container.innerHTML = '';
        let total = 0;
        let count = 0;

        if (cart.length === 0) {
            container.innerHTML = '<p class="text-center text-muted">عربة التسوق فارغة</p>';
        } else {
            cart.forEach(item => {
                total += item.price * item.quantity;
                count += item.quantity;
                container.innerHTML += `
                    <div class="cart-item-box d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="m-0 text-white">${item.name}</h6>
                            <small class="text-warning">${item.price} ر.س × ${item.quantity}</small>
                        </div>
                        <button onclick="removeFromCart('${item.id}')" class="btn btn-sm btn-danger py-0 px-2">حذف</button>
                    </div>
                `;
            });
        }

        countBadge.innerText = count;
        totalSpan.innerText = total + ' ر.س';
    }

    function proceedToCheckout() {
        if (cart.length === 0) {
            alert('عربة التسوق فارغة، يجيب إضافة منتجات أولاً!');
            return;
        }
        window.location.href = '/checkout';
    }

    // تحديث العد عند فتح الصفحة
    updateCartUI();
</script>

</body>
</html>