<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>𝐁𝐚𝐝𝐢𝐲𝐚𝐡 𝐑𝐏 | تقديم الدعم الفني</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        body {
            margin: 0; padding: 0; font-family: sans-serif; color: white;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), #2d1e0f), 
                        url('https://i.postimg.cc/brJ1MYhW/85e38e15-0b5e-4992-91f4-243974a2365f.jpg');
            background-size: cover; background-position: center; background-repeat: no-repeat;
            background-attachment: fixed; min-height: 100vh;
        }
        .navbar {
            background-color: rgba(0, 0, 0, 0.5);
            border-bottom: 2px solid #d97706;
            padding: 10px 20px;
            display: flex; justify-content: space-between; align-items: center; position: relative;
        }
        .nav-links { display: flex; gap: 15px; align-items: center; flex-wrap: wrap; }
        .logo-center { position: absolute; left: 50%; transform: translateX(-50%); height: 50px; width: auto; }
        .nav-btn {
            background-color: #020205; color: white; padding: 5px 15px;
            border-radius: 5px; text-decoration: none; border: 1px solid #d97706; font-size: 14px;
        }
        .nav-btn:hover { background-color: #1a1a1a; color: white; }
        .main-card {
            background-color: rgba(2, 1, 1, 0.9); border: 1px solid #d97706;
            border-radius: 15px; padding: 30px; margin-top: 40px; box-shadow: 0 0 20px rgba(0, 0, 0, 0.6);
        }
        .btn-submit {
            background-color: #d97706; color: white; font-weight: bold; border: none;
            padding: 10px 30px; border-radius: 8px; width: 100%; transition: 0.2s;
        }
        .btn-submit:hover { background-color: #b45309; color: white; }
    </style>
</head>
<body>

<div class="navbar">
    <div class="nav-links">
        <a href="/" class="nav-btn">الرئيسية</a>
        <a href="/login" class="nav-btn">تسجيل الدخول بالديسكورد</a>
        <a href="/store" class="nav-btn">المتجر</a>
        <a href="/rules" class="nav-btn">القوانين</a>
        <a href="/constitution" class="nav-btn">الدستور</a>
        <a href="/news" class="nav-btn">الأخبار</a>
    </div>
    <img src="https://i.postimg.cc/wMjcKP36/846c769f-65a2-4fc4-b94e-ecff458f2445.png" alt="Logo" class="logo-center">
    <div style="color: white; font-weight: bold; font-size: 18px;">Badiyah RP</div>
</div>

<div class="container my-5" style="max-width: 800px;">
    <div class="main-card">
        <h2 class="text-center mb-4" style="color: #d97706; font-weight: bold;">تقديم فريق الدعم الفني</h2>

        <% if (typeof message !== 'undefined') { %>
            <div class="alert <%= isSuccess ? 'alert-success' : 'alert-danger' %> text-center" role="alert">
                <%= message %>
            </div>
            <div class="text-center mt-3">
                <a href="/" class="nav-btn" style="padding: 10px 20px;">العودة للرئيسية</a>
            </div>
        <% } else if (questions && questions.length > 0) { %>
            <form action="/submit-support-application" method="POST">
                <% questions.forEach((q, index) => { %>
                    <div class="mb-4">
                        <label class="form-label fw-bold" style="color: #fff;"><%= index + 1 %>- <%= q.text %></label>
                        <% if (q.options) { %>
                            <select name="q<%= q.id %>" class="form-select bg-dark text-white border-warning" required>
                                <option value="" disabled selected>اختر الإجابة المناسبة...</option>
                                <% q.options.forEach(opt => { %>
                                    <option value="<%= opt %>"><%= opt %></option>
                                <% }) %>
                            </select>
                        <% } else { %>
                            <input type="text" name="q<%= q.id %>" class="form-control bg-dark text-white border-warning" required>
                        <% } %>
                    </div>
                <% }) %>
                <button type="submit" class="btn btn-submit mt-3">إرسال التقديم</button>
            </form>
        <% } %>
    </div>
</div>

<footer style="text-align: center; margin-top: 80px; margin-bottom: 40px; font-size: 16px; color: #fff;">
    <p style="margin: 0;">جميع الحقوق محفوظة © 2026 البـــادية رول بــــلاي</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>س