<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تواصل معنا | 𝐁𝐚𝐝𝐢𝐲𝐚𝐡 𝐑𝐏</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        body {
            color: white;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), #2d1e0f), 
                        url('https://i.postimg.cc/brJ1MYhW/85e38e15-0b5e-4992-91f4-243974a2365f.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
        }
        .form-container {
            background-color: rgba(45, 30, 15, 0.8);
            padding: 30px;
            border-radius: 15px;
            border: 1px solid #d97706;
            margin-top: 50px;
        }
        input, textarea {
            background: #020205 !important;
            color: white !important;
            border: 1px solid #d97706 !important;
        }
        .btn-submit { background-color: #d97706; color: white; border: none; padding: 10px 20px; border-radius: 5px; }
    </style>
</head>
<body class="container">
    <div class="form-container">
        <h2 class="text-center mb-4">تواصل معنا</h2>
        <form action="/submit-contact" method="POST">
            <div class="mb-3">
                <label>الاسم الكريم</label>
                <input type="text" name="name" class="form-control" required>
            </div>
            <div class="mb-3">
                <label>يوزر الدسكورد</label>
                <input type="text" name="discord" class="form-control" required>
            </div>
            <div class="mb-3">
                <label>موضوعك</label>
                <textarea name="message" class="form-control" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn-submit">إرسال</button>
        </form>
    </div>
</body>
</html>