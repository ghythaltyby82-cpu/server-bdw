<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الدفع والتحويل البنكي - سيرفر البادية RP</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen py-10 px-4 flex items-center justify-center">
    <div class="bg-zinc-900 border border-zinc-800 p-8 rounded-2xl shadow-2xl w-full max-w-xl">
        <h2 class="text-2xl font-extrabold text-amber-500 mb-6 text-center">💳 بيانات التحويل البنكي</h2>

        <!-- معلومات الحساب -->
        <div class="space-y-4 mb-6 bg-zinc-950 p-5 rounded-xl border border-zinc-800">
            <div class="flex justify-between items-center">
                <span>اسم المستفيد: <strong><%= bankInfo.name %></strong></span>
                <button onclick="copyText('<%= bankInfo.name %>')" class="bg-zinc-800 hover:bg-zinc-700 text-xs px-3 py-1 rounded">نسخ</button>
            </div>
            <div class="flex justify-between items-center">
                <span>رقم الحساب: <strong id="acc-num"><%= bankInfo.accountNumber %></strong></span>
                <button onclick="copyText('<%= bankInfo.accountNumber %>')" class="bg-zinc-800 hover:bg-zinc-700 text-xs px-3 py-1 rounded">نسخ</button>
            </div>
            <div class="flex justify-between items-center">
                <span>رقم الآيبان (IBAN): <strong id="iban-num"><%= bankInfo.iban %></strong></span>
                <button onclick="copyText('<%= bankInfo.iban %>')" class="bg-zinc-800 hover:bg-zinc-700 text-xs px-3 py-1 rounded">نسخ</button>
            </div>
            <div class="flex justify-between items-center">
                <span>البنك: <strong>الراجحي (Al Rajhi)</strong></span>
            </div>
        </div>

        <!-- التحذير الرسمي -->
        <div class="bg-red-950/40 border border-red-800 text-red-300 p-4 rounded-xl text-sm mb-6">
            ⚠️ <strong>تحذير رسمى:</strong> يرجى التأكد من تحويل المبلغ المطلوب كاملاً وعدم إرسال أي إيصال وهمي، فسيتم حظر العضو نهائياً من السيرفر والموقع في حال التلاعب.
        </div>

        <!-- نموذج رفع الإيصال -->
        <form action="/submit-receipt" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label class="block text-sm font-bold mb-2">ارفاق صورة إيصال التحويل:</label>
                <input type="file" name="receiptImage" accept="image/*" required class="w-full bg-zinc-950 border border-zinc-800 rounded-lg p-2 text-sm text-zinc-400 file:bg-amber-600 file:text-white file:border-none file:rounded file:px-4 file:py-2">
            </div>

            <button type="submit" class="w-full bg-green-600 hover:bg-green-500 text-white font-bold py-3 rounded-lg transition">
                إرسال الإيصال للإدارة 
            
            </button>
        </form>
    </div>

    <script>
        function copyText(text) {
            navigator.clipboard.writeText(text);
            alert('تم التنسيق والنسخ إلى الحافظة بنجاح!');
        }
    </script>
</body>
</html>