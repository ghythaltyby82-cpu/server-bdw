<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title><%= typeof appDetails !== 'undefined' ? appDetails.title : 'تقديم على البادية' %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        body { 
            background-image: linear-gradient(to top, #613911, transparent), url('https://i.postimg.cc/brJ1MYhW/85e38e15-0b5e-4992-91f4-243974a2365f.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: white; 
            min-height: 100vh;
        }
        
        .card { 
            background-color: rgba(2, 1, 1, 0.9);
            border: 1px solid #d97706; 
            padding: 25px; 
            border-radius: 15px; 
        }

        /* جعل ألوان الأسئلة والنصوص بالداخل بيضاء واضحة */
        .card h5, .card p, .card label {
            color: #ffffff !important;
        }

        /* العنوان الرئيسي بلون ثيم الموقع */
        .main-title {
            color: #d97706;
            text-shadow: 0 0 10px rgba(217, 119, 6, 0.4);
        }
        
        .question-step { display: none; }
        .question-step.active { display: block; }
        .btn-custom { background-color: #d97706; color: white; border: none; }
        .btn-custom:hover { background-color: #b45f04; color: white; }

        footer {
            text-align: left;
            margin-left: 20px;
            color: #fff;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        
        <!-- صندوق الرسالة (يظهر عند الانتهاء من الاختبار وإرسال النتائج) -->
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert <%= typeof isSuccess !== 'undefined' && isSuccess ? 'alert-success' : 'alert-danger' %>" 
                 style="background-color: #020101; border: 1px solid #d97706; color: white; text-align: right; margin-bottom: 20px; padding: 20px;">
                <h4 class="alert-heading"><%= typeof isSuccess !== 'undefined' && isSuccess ? 'مبروك!' : 'تنبيه' %></h4>
                <p><%= typeof message === 'object' ? JSON.stringify(message) : message %></p>
                <hr style="border-color: #d97706;">
                <a href="/" class="btn btn-custom">العودة للرئيسية</a>
            </div>
        <% } %>

        <!-- نموذج الانضمام (يظهر فقط إذا لم تكن هناك رسالة نتيجة معروضة وكانت الأسئلة موجودة) -->
        <% if (typeof questions !== 'undefined' && questions.length > 0) { %>
            <h2 class="text-center mb-2 main-title fw-bold"><%= typeof appDetails !== 'undefined' ? appDetails.title : 'نموذج الانضمام للسيرفر' %></h2>
            <% if (typeof appDetails !== 'undefined' && appDetails.description) { %>
                <p class="text-center text-white-50 mb-4"><%= appDetails.description %></p>
            <% } %>

            <!-- التوجيه التلقائي للمسار الصحيح بناءً على وجود appId أو كونه تقديم تفعيل -->
            <form id="applyForm" action="<%= typeof appDetails !== 'undefined' && appDetails.id ? '/submit-application' : '/submit-activation' %>" method="POST">
                <% if (typeof appDetails !== 'undefined' && appDetails.id) { %>
                    <input type="hidden" name="appId" value="<%= appDetails.id %>">
                <% } %>

                <% questions.forEach((q, index) => { %>
                    <div class="question-step <%= index === 0 ? 'active' : '' %>" id="step-<%= index + 1 %>">
                        <div class="card">
                            <h5>السؤال <%= index + 1 %> من <%= questions.length %></h5>
                            <p class="lead"><%= typeof q === 'string' ? q : q.text %></p>
                            
                            <!-- دعم الأسئلة الديناميكية (إدخال نصي أو خيارات حسب المتوفر) -->
                            <% if (typeof q === 'object' && q.options && q.options.length > 0) { %>
                                <% q.options.forEach(opt => { %>
                                    <div class="form-check my-2">
                                        <input class="form-check-input" type="radio" name="q<%= index %>" value="<%= opt %>" required style="background-color: rgba(45, 30, 15, 0.9); border-color: #d97706;">
                                        <label class="form-check-label"><%= opt %></label>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="my-3">
                                    <input type="text" name="q<%= index %>" class="form-control bg-dark text-white border-warning" placeholder="اكتب إجابتك هنا..." required>
                                </div>
                            <% } %>

                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-secondary" onclick="prevStep(<%= index + 1 %>)" <%= index === 0 ? 'disabled' : '' %>>السابق</button>

                                <% if(index < questions.length - 1) { %>
                                    <button type="button" class="btn btn-custom" onclick="nextStep(<%= index + 1 %>)">التالي</button>
                                <% } else { %>
                                    <button type="submit" class="btn btn-success">إرسال الطلب</button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </form>
        <% } %>
    </div>

    <script>
        function nextStep(i) {
            const fieldName = `q${i - 1}`;
            const selectedInput = document.querySelector(`[name="${fieldName}"]:checked`) || document.querySelector(`[name="${fieldName}"]`);
            
            if (!selectedInput || (selectedInput.type === 'text' && selectedInput.value.trim() === '')) {
                alert("يرجى الإجابة على السؤال للمتابعة!");
                return;
            }
            document.getElementById('step-' + i).classList.remove('active');
            document.getElementById('step-' + (i + 1)).classList.add('active');
        }

        function prevStep(i) {
            document.getElementById('step-' + i).classList.remove('active');
            document.getElementById('step-' + (i - 1)).classList.add('active');
        }
    </script>
    <footer>
        <p style="font-size: 20px;">جميع الحقوق محفوظة © 2026 البـادية رول بــلاي</p>
    </footer>
</body>
</html>